# The build ships uncompressed so the host can compress it on the fly. Pre-compressing it
# instead means either bundling a JS decompressor or having the host compress what's already
# compressed, which arrives double-wrapped and won't parse.
#
# The wasm has to be application/wasm to compile as it streams.
#
# The data file is deliberately mislabelled: hosts only compress types they consider text,
# so as octet-stream it ships at 8.9MB instead of 3.3MB. The loader reads it as an array
# buffer and never looks at the type, so the label costs nothing and saves 5MB.

/Build/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=3600

/Build/*.data
  Content-Type: text/plain
  Cache-Control: public, max-age=3600
