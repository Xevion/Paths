<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>Paths.Core</AssemblyName>
    <!-- Unity 2020.3 is on C# 8, so don't let this build accept syntax the editor would reject. -->
    <LangVersion>8.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- exactly what Unity compiles through the asmdef, and nothing else -->
  <ItemGroup>
    <Compile Include="Runtime/**/*.cs" />
  </ItemGroup>

</Project>
